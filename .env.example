# Copy to .env and fill in. Leave WATSONX_* empty to run in offline demo mode.
JWT_SECRET=replace-with-a-long-random-string
CORS_ORIGINS=http://localhost:5173

WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
GRANITE_MODEL_ID=ibm/granite-3-8b-instruct
EMBEDDING_MODEL_ID=ibm/granite-embedding-278m-multilingual
EMBEDDING_DIM=768

# External literature search
# Set to false to hide the feature entirely (endpoints return 404, UI hides the panel)
EXTERNAL_SEARCH_ENABLED=true
# Your email address — required for the OpenAlex "polite pool" (free, no registration needed)
# Leave blank to disable the OpenAlex provider (arXiv will still work)
OPENALEX_API_KEY=you@example.com
# Sent in the User-Agent header to all external providers
EXTERNAL_CONTACT_EMAIL=admin@example.com
# How many hours to reuse a cached query before re-fetching (saves API budget)
EXTERNAL_CACHE_HOURS=24
# HTTP timeout in seconds for calls to external providers
EXTERNAL_TIMEOUT_SECONDS=10
